# Copy to .env.production for CLI, or enter these values in Portainer stack variables.
# Required: build the DPS fork on the target Docker engine; e.g. dps-cqa:<gitsha>.
# Do not use the upstream Docker Hub image for DPS Custom AI features.
CQA_IMAGE=
# Proposed domain: create DNS and NPM Proxy Host before using it.
APP_URL=https://cqa.dps.media
DB_NAME=cqa
DB_USER=cqa
# Generate separate random production values; never reuse local credentials.
# DB_PASSWORD and MYSQL_ROOT_PASSWORD: separate `openssl rand -hex 32` outputs.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 64 ASCII characters: openssl rand -hex 32
JWT_SECRET=
# Exactly 32 ASCII bytes: openssl rand -hex 16. Keep stable across updates/restores.
ENCRYPTION_KEY=
RATE_LIMIT_PER_IP=500
RATE_LIMIT_PER_USER=1000
